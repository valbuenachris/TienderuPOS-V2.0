# Docker Hub image namespace/tag used by build and deployment Compose files.
DOCKERHUB_NAMESPACE=cvalbuena
IMAGE_TAG=v0.1.0

# These external Docker networks must already exist on the deployment host.
NPM_NETWORK_NAME=npm_net
SUPABASE_NETWORK_NAME=supabase_default

# Server-side connection only. Never put DATABASE_URL in the web bundle.
# Replace the username, password, and hostname with values reachable on SUPABASE_NETWORK_NAME.
DATABASE_URL=postgresql://postgres:CHANGE_ME@supabase-db:5432/postgres
# Set true when the remote PostgreSQL endpoint requires TLS.
DATABASE_SSL=false
PG_POOL_MAX=15
# Use a Supabase API URL reachable from the API container (hosted or self-hosted).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_server_side_only
# Browser-reachable public base used to build stored product image URLs (REQUIRED for image uploads),
# and storage bucket name. Never use the internal Docker hostname (e.g. supabase-kong) here.
SUPABASE_PUBLIC_URL=https://supabase.tienderu.com
SUPABASE_PRODUCT_BUCKET=productos

# Generate a unique random secret of at least 32 bytes.
JWT_SECRET=CHANGE_ME_with_a_random_secret_of_at_least_32_bytes
JWT_TTL_SECONDS=28800
BCRYPT_ROUNDS=12
# Business timezone used for "today" boundaries in cash register and daily sales (IANA name).
POS_TIMEZONE=America/Bogota
# Keep false while the legacy POS (sha1) shares tec_users passwords.
# Enabling it upgrades legacy hashes to bcrypt after a successful login.
PASSWORD_REHASH_ENABLED=false
# Hash used when creating/updating users from the V2. Keep sha1 while the legacy POS logs in
# with the same accounts; switch to bcrypt after the legacy cutover.
USER_PASSWORD_METHOD=sha1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=600
# Morosidad (sin DDL): el job horario suspende suscripciones vencidas más de la gracia
# (tenant inactive + sesiones borradas + POS de venta en 402). false = solo avisa en logs.
BILLING_AUTO_SUSPEND=false
BILLING_GRACE_DAYS=3
# Bold Checkout (API Link de pagos). BOLD_API_KEY = llave de identidad (formato real:
# alfanumérica larga; NO sk_live_). En sandbox la firma usa secreto vacío; en producción
# el webhook se firma con BOLD_API_KEY (Bold no usa un secreto aparte).
BOLD_ENABLED=false
BOLD_API_KEY=
# Opcional: si se deja vacío, el webhook usa BOLD_API_KEY como secreto de firma.
BOLD_WEBHOOK_SECRET=
# Base de Link de pagos (alias soportado: BOLD_API_BASE).
BOLD_LINKS_BASE_URL=https://integrations.api.bold.co
# true para sandbox (también se detecta si la URL contiene "sandbox").
BOLD_SANDBOX=false
BOLD_CALLBACK_URL=https://pos.tienderu.com/config?payment=return
BOLD_LINK_EXPIRATION_MINUTES=30
# Opcional: vacío usa CREDIT_CARD, PSE, BOTON_BANCOLOMBIA, NEQUI.
BOLD_PAYMENT_METHODS=
# Addi (Custom Integrations, server-to-server). Las llaves viven POR TENANT en
# tec_tenant_payment_settings (addi_api_key = client_id, addi_webhook_secret =
# client_secret); aquí solo van URLs/comportamiento global. Los defaults apuntan
# a SANDBOX: define los valores de producción que te dé el portal de Addi.
ADDI_AUTH_URL=https://auth.addi-staging.com/oauth/token
ADDI_AUDIENCE=https://api.staging.addi.com
ADDI_API_BASE_URL=https://api.staging.addi.com
# TODO: CAMPO_REAL_DE_ADDI — path del endpoint de creación de solicitud (placeholder v0.3.79).
ADDI_APPLICATIONS_PATH=/v1/online-applications
# Webhook público que se envía a Addi como callbackUrl.
ADDI_CALLBACK_URL=https://pos.tienderu.com/api/webhooks/addi
# CC de prueba para el payload de Addi (sandbox) mientras tec_customers no tenga documento.
ADDI_TEST_DOCUMENT_NUMBER=1001234567
# Incluir el bloque `shipping` (country CO) en el payload; false para probar sin él.
ADDI_SEND_SHIPPING=true
# Retorno del usuario al terminar en Addi (fallback si el tenant no define return_url).
CUSTOMER_PAYMENT_RETURN_URL=https://pos.tienderu.com
# Marketplace Tienderu.com (v0.8.0): la tienda pública cobra con la cuenta Bold DE LA
# PLATAFORMA (los tenants publican con opt-in y la comisión queda en la plataforma).
MARKETPLACE_BOLD_API_KEY=
# Opcional: si se deja vacío, el webhook MKP usa MARKETPLACE_BOLD_API_KEY como secreto.
MARKETPLACE_BOLD_WEBHOOK_SECRET=
# Tarifa de envío plana por pedido (COP, entero o decimal; 0 = envío gratis).
MARKETPLACE_SHIPPING_FLAT=0
# Minutos antes de cancelar automáticamente un pedido sin pago y reponer stock (default 60; 5..1440).
# Debe ser mayor que la expiración del link Bold (BOLD_LINK_EXPIRATION_MINUTES, default 30).
MARKETPLACE_PAYMENT_TTL_MINUTES=60
# Retorno del cliente al terminar el pago en Bold (su cuenta de pedidos en la tienda).
MARKETPLACE_CALLBACK_URL=https://tienderu.com/pedidos
# Sistecrédito (aún stub): base del checkout simulado.
SISTECREDITO_CHECKOUT_BASE_URL=https://sandbox.sistecredito.com/checkout
# Asistente IA (OpenRouter). La key es GLOBAL de la plataforma (se cobra aquí);
# los tenants eligen modelo pero nunca ven la key. Deja la key vacía para desactivar.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
# Failover automático (parámetro `models` de OpenRouter): si el primario falla, se usa este.
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-v4.1-flash-1017
# Límite diario de mensajes al asistente por tenant (control de gasto; default 100).
AI_DAILY_MESSAGES_LIMIT=100
# WhatsApp / Evolution API (el MISMO servidor que usa educol). La key es global de la
# plataforma; cada tenant crea SU instancia desde el POS y la key nunca se expone.
EVOLUTION_API_URL=https://evoapi.grupoempresarialroma.com
EVOLUTION_API_KEY=
# Token del webhook del bot (Evolution lo envía como ?token=). Generar: openssl rand -hex 32
EVOLUTION_WEBHOOK_TOKEN=
# URL pública del API para registrar el webhook en Evolution (alcanzable por Evolution).
PUBLIC_API_URL=https://pos.tienderu.com
# CRM · automatizaciones: ventana horaria (hora local del tenant) y tope diario por tienda.
CRM_AUTOMATION_START_HOUR=8
CRM_AUTOMATION_END_HOUR=19
CRM_AUTOMATION_DAILY_LIMIT=50
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Opcionales: atribución en el leaderboard de OpenRouter.
OPENROUTER_APP_URL=https://pos.tienderu.com
OPENROUTER_APP_TITLE=Tienderu POS
# Legacy fallback only: login now resolves the tenant from tec_users.tenant_id
# (single-domain SaaS). DEFAULT_TENANT_ID/TENANT_HOST_MAP only bucket failed
# login attempts for identities that match no user.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Optional JSON map: trusted reverse-proxy hostname -> tenant UUID (legacy fallback).
TENANT_HOST_MAP={}

API_PORT=3000
WEB_PORT=8080
# Bind address for the web port. Keep 127.0.0.1 for a local test; use 0.0.0.0
# (restricted by firewall to the proxy host) when Nginx Proxy Manager runs on another VPS.
WEB_BIND_IP=127.0.0.1
# Tienda pública tienderu.com (v0.8.1): contenedor pos-gres-v2-store. Apunta
# tienderu.com en NPM a pos-gres-v2-store:80 (misma red npm_net) o a STORE_BIND_IP:STORE_PORT.
STORE_PORT=8081
STORE_BIND_IP=127.0.0.1
# Product images: when tec_products.image stores a full URL (e.g. Supabase Storage),
# the API returns it unchanged. PRODUCT_IMAGE_BASE_URL is only the prefix for legacy filename
# values; LEGACY_UPLOADS_PATH is the folder mounted read-only in the web container for those.
PRODUCT_IMAGE_BASE_URL=/uploads/thumbs
LEGACY_UPLOADS_PATH=/srv/pos-media/uploads
NODE_ENV=production
